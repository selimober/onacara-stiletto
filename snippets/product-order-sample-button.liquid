{% doc %}
  Renders a secondary "Order sample fabric" CTA that adds linked sample products to the cart in one go.

  @param sample_products - List of sample products to add to the cart when the button is clicked.

  @example
  {% render 'product-order-sample-button', sample_products: product.metafields.custom.sample_products.value %}
{% enddoc %}

{%- liquid
  if sample_products == blank
    break
  endif

  assign sample_variant_ids = ''

  for sample_product in sample_products
    assign sample_variant = sample_product.selected_or_first_available_variant
    if sample_variant != blank and sample_variant.available
      if sample_variant_ids == ''
        assign sample_variant_ids = sample_variant.id | append: ''
      else
        assign sample_variant_ids = sample_variant_ids | append: ',' | append: sample_variant.id
      endif
    endif
  endfor

  if sample_variant_ids == ''
    break
  endif

  assign sample_count = sample_variant_ids | split: ',' | size
-%}

<div class="product-form__order-sample">
  <button
    type="button"
    class="product-form__order-sample-btn btn btn--medium btn--full btn--secondary"
    data-sample-button
    data-sample-variant-ids="{{ sample_variant_ids }}"
  >
    <span data-sample-button-text>{{ 'products.product.order_sample' | t: count: sample_count }}</span>
    <div class="btn__loading-wrap">
      <div class="btn__loading-bar"></div>
    </div>
  </button>
  <span
    class="product-form__order-sample-error product__quantity-error fs-body-75 hidden"
    data-sample-error
    role="status"
    aria-live="polite"
  ></span>
</div>

{% stylesheet %}
  .product-form__order-sample {
    margin-top: var(--spacing-3);
  }

  .product-form__order-sample-error {
    margin-top: var(--spacing-2);
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (document.documentElement.dataset.orderSampleBound) return;
    document.documentElement.dataset.orderSampleBound = 'true';

    var LOADING_CLASS = 'loading';
    var HIDDEN_CLASS = 'hidden';

    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-sample-button]');
      if (!button) return;
      if (button.classList.contains(LOADING_CLASS)) return;

      event.preventDefault();

      var variantIds = (button.dataset.sampleVariantIds || '')
        .split(',')
        .map(function (id) { return id.trim(); })
        .filter(Boolean);
      if (variantIds.length === 0) return;

      var errorEl = button.parentNode.querySelector('[data-sample-error]');
      if (errorEl) {
        errorEl.classList.add(HIDDEN_CLASS);
        errorEl.textContent = '';
      }

      button.classList.add(LOADING_CLASS);

      fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: variantIds.map(function (id) { return { id: id, quantity: 1 }; })
        })
      })
        .then(function (response) {
          return response.json().then(function (data) {
            return { ok: response.ok, status: response.status, data: data };
          });
        })
        .then(function (result) {
          button.classList.remove(LOADING_CLASS);

          if (!result.ok || result.status >= 400) {
            var message = (result.data && (result.data.description || result.data.message)) || '';
            if (errorEl && message) {
              errorEl.textContent = message;
              errorEl.classList.remove(HIDDEN_CLASS);
            }
            return;
          }

          document.dispatchEvent(new CustomEvent('apps:product-added-to-cart', {
            detail: { items: result.data && result.data.items }
          }));

          var cartIcon = document.querySelector('[data-js-cart-icon]');
          if (cartIcon) cartIcon.click();
        })
        .catch(function () {
          button.classList.remove(LOADING_CLASS);
        });
    });
  })();
{% endjavascript %}
